# docker compose(本体をDockerで動かす場合)用の設定。
#   cp .env.example .env
# ベアメタルで `npm start` する場合はこのファイルではなく server/.env を使う。

# --- データの置き場所(必須・絶対パス) ---
# SQLiteとclone先(workspaces)を置くホスト側ディレクトリ。
# 対象リポジトリのbind mountを壊さないため、コンテナ内にも**同じ絶対パス**でマウントする。
DATA_DIR="/srv/pr-preview"

# --- 本体の公開設定 ---
# WebUI/APIを公開するホストポート。
APP_PORT="8787"
# 待ち受けアドレス。ADMIN_USER/ADMIN_PASSWORDを設定しない場合は127.0.0.1を推奨。
APP_BIND="0.0.0.0"
# コンテナ名(同一ホストで名前が衝突する場合に変更する)。
CONTAINER_NAME="pr-preview-orchestrator"

# --- 管理画面/APIのBasic認証(任意・空なら認証なし) ---
ADMIN_USER=""
ADMIN_PASSWORD=""

# --- GitHub(任意) ---
# Personal Access Token。レート制限の緩和とprivateリポジトリ対応。
GITHUB_TOKEN=""
# Webhook署名の検証に使うシークレット。
GITHUB_WEBHOOK_SECRET=""

# --- プレビュー環境 ---
# ブラウザから見たプレビューのホスト名(トンネル無効時のURL生成に使う)。
# リモートのサーバーで動かす場合はそのホスト名/IPに変更する。
PREVIEW_HOST="localhost"
# プレビューに割り当てるホストポートの範囲。
PREVIEW_PORT_MIN="13000"
PREVIEW_PORT_MAX="13999"
# Cloudflare Quick Tunnel での外部公開。
PREVIEW_TUNNEL="true"
# 同時に処理するビルドジョブ数。
PREVIEW_JOB_CONCURRENCY="3"
# ビルドのアイドルタイムアウト(ms)。出力が無いまま経過した場合に中断する。
PREVIEW_BUILD_TIMEOUT_MS="600000"
